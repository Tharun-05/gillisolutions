# Cloudflare Pages response headers (the same rules as .htaccess)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  # >>> csp (generated by tools/build.py)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-q4+ivQt0Q9Otam7XPzUS98LxnK5wiBwoZ3tJJ+37Tzc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://airmasteremirates.com https://ik.imagekit.io https://img-new.cgtrader.com https://m.media-amazon.com https://tse1.mm.bing.net https://tse3.mm.bing.net https://www.commercial-kitchenequipments.com https://www.mdpi.com; media-src 'self' https://ik.imagekit.io; connect-src 'self' https://api.web3forms.com https://tiles.openfreemap.org; worker-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  # <<< csp

# The content manager loads its editor from unpkg and talks to GitHub, so it gets no CSP.
/admin/*
  ! Content-Security-Policy

/assets/uploads/*
  Cache-Control: public, max-age=2592000

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
